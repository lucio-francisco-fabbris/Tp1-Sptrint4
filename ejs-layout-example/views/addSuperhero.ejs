<div><h1>Agregar Superhéroe</h1></div>

<div >
    <form action="/add" method="post">
    <input type="text" name="nombreSuperHeroe" placeholder="Nombre Del Superheroe">
    <input type="text" name="nombreReal" placeholder="Nombre Real">
    <input type="number" name="edad" placeholder="Edad">
    <input type="text" name="planetaOrigen" placeholder="Planeta Origen">
    <input type="text" name="poderes" placeholder="Poderes">
    <button type="submit">Agregar</button>
</form>

<% if (error) { %>
        <p style="color: red;"><%= error %></p>
    <% } %>
</div>